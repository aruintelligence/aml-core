{
  "protocol": "aml-publication-contract/1",
  "registry": "https://registry.npmjs.org/",
  "package": "aml-core",
  "stable": {
    "version": "1.3.0",
    "dist_tag": "latest",
    "git_tag": "v1.3.0"
  },
  "required_preconditions": [
    "release_readiness_bundle_valid",
    "artifact_provenance_binding_valid",
    "release_signing_threshold_satisfied",
    "rollback_target_resolvable",
    "registry_target_version_absent_before_first_publish"
  ],
  "postconditions": [
    "registry_version_matches",
    "registry_integrity_matches_bound_artifact",
    "registry_shasum_matches_bound_artifact",
    "dist_tag_points_to_expected_version",
    "clean_registry_install_smoke_test_passes"
  ],
  "rollback": {
    "immutable_source_tag": "v1.3.0",
    "do_not_delete_or_rewrite_published_artifact": true,
    "dist_tag_changes_require_review": true,
    "source_rollback_must_rehearse_clean_install": true
  },
  "claim_boundary": "Project-controlled publication transaction contract. Passing the rehearsal does not prove npm publication, registry control, third-party attestation, adoption, certification, or production suitability."
}
