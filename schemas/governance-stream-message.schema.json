{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruintelligence.github.io/aml-core/schemas/governance-stream-message.schema.json",
  "title": "ĀML Continuous Governance Stream Message",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "const": "aml-governance-stream-open/1" },
        "transmission": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["enforce", "shadow"] },
        "failure_mode": { "enum": ["closed", "open"] },
        "context": { "type": "object" },
        "timestamp": { "type": "string" },
        "policy_authorization": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "threshold": { "type": "integer", "minimum": 1 },
            "trusted_fingerprints": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
            "revoked_fingerprints": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
            "required_scope": { "type": "string", "minLength": 1 },
            "require_trusted_keys": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["protocol", "node"],
      "properties": {
        "protocol": { "const": "aml-governance-stream-node/1" },
        "node": {
          "type": "object",
          "required": ["type", "properties"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "identifier": { "type": "string", "minLength": 1 },
            "properties": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "const": "aml-governance-stream-policy-update/1" },
        "profile": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["enforce", "shadow"] },
        "failure_mode": { "enum": ["closed", "open"] },
        "context": { "type": "object" },
        "context_mode": { "enum": ["merge", "replace"] },
        "authorization": { "type": "object" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["protocol"],
      "properties": { "protocol": { "const": "aml-governance-stream-finalize/1" } },
      "additionalProperties": true
    }
  ]
}
