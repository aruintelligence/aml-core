{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruintelligence.github.io/aml-core/schemas/governance-policy-transition-authorization.schema.json",
  "title": "ĀML Governance Policy Transition Authorization",
  "type": "object",
  "required": ["protocol", "transition", "signatures"],
  "properties": {
    "protocol": { "const": "aml-governance-policy-transition-authorization/1" },
    "transition": {
      "type": "object",
      "required": ["protocol", "transmission", "expected_policy_epoch", "previous_policy_sha256", "update"],
      "properties": {
        "protocol": { "const": "aml-governance-policy-transition/1" },
        "transmission": { "type": "string", "minLength": 1 },
        "expected_policy_epoch": { "type": "integer", "minimum": 0 },
        "previous_policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "update": { "type": "object", "minProperties": 1 }
      },
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["algorithm", "key_id", "public_key_fingerprint_sha256", "public_key_pem", "signature_base64", "scope"],
        "properties": {
          "algorithm": { "const": "Ed25519" },
          "key_id": { "type": "string", "minLength": 1 },
          "public_key_fingerprint_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "public_key_pem": { "type": "string", "minLength": 1 },
          "signature_base64": { "type": "string", "minLength": 1 },
          "signer": { "type": ["string", "null"] },
          "scope": { "type": "string", "minLength": 1 },
          "signed_at": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
