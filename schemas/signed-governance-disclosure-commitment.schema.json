{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruintelligence.github.io/aml-core/schemas/signed-governance-disclosure-commitment.schema.json",
  "title": "ĀML Signed Governance Disclosure Commitment",
  "type": "object",
  "required": ["protocol", "commitment", "signature"],
  "properties": {
    "protocol": { "const": "aml-signed-governance-disclosure-commitment/1" },
    "commitment": {
      "type": "object",
      "required": ["protocol", "source_transcript_root_sha256", "source_entry_count", "disclosure_merkle_root_sha256"],
      "properties": {
        "protocol": { "const": "aml-governance-disclosure-commitment/1" },
        "source_transcript_root_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_entry_count": { "type": "integer", "minimum": 1 },
        "disclosure_merkle_root_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "public_key_fingerprint_sha256", "public_key_pem", "signature_base64", "scope"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "public_key_fingerprint_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "public_key_pem": { "type": "string", "minLength": 1 },
        "signature_base64": { "type": "string", "minLength": 1 },
        "signer": { "type": ["string", "null"] },
        "scope": { "type": "string", "minLength": 1 },
        "signed_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
