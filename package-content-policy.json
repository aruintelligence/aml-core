{
  "protocol": "aml-package-content-policy/1",
  "package": "aml-core",
  "required_files": [
    "LICENSE",
    "README.md",
    "index.js",
    "index.d.ts",
    "package.json",
    "package-surface.json",
    "api-stability.json"
  ],
  "forbidden_exact": [
    ".env",
    ".npmrc"
  ],
  "forbidden_suffixes": [
    ".pem",
    ".key",
    ".p12",
    ".pfx"
  ],
  "forbidden_fragments": [
    "private-key",
    "private_key",
    "id_rsa"
  ],
  "claim_boundary": "This policy constrains project-controlled package contents. It is not a substitute for independent supply-chain review, secret scanning, or registry-side provenance verification."
}
