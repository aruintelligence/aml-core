{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruintelligence.github.io/aml-core/protocol/aml-verification-quorum.schema.json",
  "title": "AML Verification Quorum",
  "description": "Prototype aggregation of multiple AML verification reports over the same artifact hash.",
  "type": "object",
  "required": ["schema", "prototype", "artifact_type", "artifact_hash", "threshold", "reports", "summary"],
  "properties": {
    "schema": { "const": "aml-verification-quorum/1" },
    "prototype": { "const": true },
    "artifact_type": { "type": "string", "minLength": 1 },
    "artifact_hash": { "type": "string", "minLength": 1 },
    "threshold": { "type": "integer", "minimum": 1 },
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "object" }
    },
    "summary": {
      "type": "object",
      "required": ["distinct_verifiers", "valid_reports", "invalid_reports", "threshold_met", "unanimous"],
      "properties": {
        "distinct_verifiers": { "type": "integer", "minimum": 0 },
        "valid_reports": { "type": "integer", "minimum": 0 },
        "invalid_reports": { "type": "integer", "minimum": 0 },
        "threshold_met": { "type": "boolean" },
        "unanimous": { "type": "boolean" },
        "disagreement_reasons": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
