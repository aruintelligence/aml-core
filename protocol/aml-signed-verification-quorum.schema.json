{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruintelligence.github.io/aml-core/protocol/aml-signed-verification-quorum.schema.json",
  "title": "AML Signed Verification Quorum",
  "description": "Prototype aggregation of cryptographically signed AML verification reports over one exact artifact hash.",
  "type": "object",
  "required": ["schema", "prototype", "artifact_type", "artifact_hash", "threshold", "signed_reports", "summary", "claim_boundary"],
  "properties": {
    "schema": { "const": "aml-signed-verification-quorum/1" },
    "prototype": { "const": true },
    "artifact_type": { "type": "string", "minLength": 1 },
    "artifact_hash": { "type": "string", "minLength": 1 },
    "threshold": { "type": "integer", "minimum": 1 },
    "signed_reports": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object" } },
    "summary": {
      "type": "object",
      "required": ["distinct_keys", "valid_signatures", "valid_reports", "invalid_reports", "threshold_met", "unanimous"],
      "properties": {
        "distinct_keys": { "type": "integer", "minimum": 0 },
        "valid_signatures": { "type": "integer", "minimum": 0 },
        "valid_reports": { "type": "integer", "minimum": 0 },
        "invalid_reports": { "type": "integer", "minimum": 0 },
        "threshold_met": { "type": "boolean" },
        "unanimous": { "type": "boolean" },
        "disagreement_reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
