{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruintelligence.github.io/aml-core/conformance/implementation-declaration.schema.json",
  "title": "ĀML Conformance Implementation Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "implementation", "version", "language", "source", "test_vector_commit", "result"],
  "properties": {
    "protocol": {
      "const": "aml-conformance/decision-core-1"
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "test_vector_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "result": {
      "enum": ["PASS", "FAIL"]
    },
    "tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}
