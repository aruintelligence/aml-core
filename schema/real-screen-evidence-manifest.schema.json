{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aruintelligence/aml-core/schema/real-screen-evidence-manifest.schema.json",
  "title": "ĀML Real-Screen Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "source",
    "capture",
    "labels",
    "aml",
    "receipt",
    "reproducibility",
    "real_screen_evidence_eligible",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "aml-real-screen-evidence-manifest/1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "environment": {"type": ["string", "null"]}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "artifacts"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "provenance": {"type": ["string", "null"]},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "media_type": {"type": ["string", "null"]},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "provenance"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provenance": {"type": "string", "minLength": 1},
        "measurement_boundary": {"type": ["string", "null"]}
      }
    },
    "aml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_or_commit", "policy"],
      "properties": {
        "version_or_commit": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "minLength": 1}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "root": {"type": ["string", "null"]}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rerun_performed", "byte_identical"],
      "properties": {
        "rerun_performed": {"type": "boolean"},
        "byte_identical": {"type": ["boolean", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "after_state": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "artifacts": {"type": "array"},
        "production_verified": {"type": "boolean"}
      }
    },
    "real_screen_evidence_eligible": {"type": "boolean"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "legacy_migration_notes": {"type": ["string", "null"]}
  }
}
