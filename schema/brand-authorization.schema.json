{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aruintelligence.github.io/aml-core/schema/brand-authorization.schema.json",
  "title": "AML Brand Authorization Credential",
  "type": "object",
  "required": ["type", "issuer", "grantee", "authorization_id", "marks", "permitted_uses", "credential_hash", "algorithm", "public_key_pem", "public_key_sha256", "signature_base64"],
  "properties": {
    "type": { "const": "aml-brand-authorization/1" },
    "issuer": { "type": "string", "minLength": 1 },
    "grantee": { "type": "string", "minLength": 1 },
    "authorization_id": { "type": "string", "minLength": 1 },
    "marks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "permitted_uses": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "issued_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "expires_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "agreement_reference": { "type": ["string", "null"] },
    "credential_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "algorithm": { "const": "Ed25519" },
    "public_key_pem": { "type": "string", "minLength": 1 },
    "public_key_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature_base64": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
