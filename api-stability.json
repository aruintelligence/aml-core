{
  "protocol": "aml-api-stability/1",
  "package": "aml-core",
  "channel": "main-prepublication",
  "policy": {
    "removal_requires": "explicit release-contract review and a SemVer major version for a published stable package",
    "additions": "allowed when backward-compatible",
    "type_declarations_required": true,
    "runtime_exports_required": true
  },
  "protected_exports": [
    "compileAML",
    "compileSource",
    "generateAMLFromIntent",
    "simulatePolicies",
    "semanticDiff",
    "policyDiff",
    "ethicalRenderGate",
    "createInterfaceFirewall",
    "enforceInterfaceIntent",
    "evaluateAgentUI",
    "createGovernanceStreamSession",
    "createGovernanceStreamTranscript",
    "verifyGovernanceStreamTranscript",
    "signGovernanceStreamTranscript",
    "verifySignedGovernanceStreamTranscript",
    "evaluateGovernanceWitnessQuorum",
    "localizeRuntimeDisagreement",
    "createGovernanceDisclosure",
    "verifyGovernanceDisclosure",
    "createGovernancePolicyTransition",
    "createAmlHttpServer",
    "createAgentUiGateway",
    "createGovernanceStreamGateway",
    "runAmlDoctor",
    "AML_AGENT_UI_ENVELOPE",
    "AML_AGENT_UI_RESULT",
    "AML_GOVERNANCE_TRANSCRIPT",
    "AML_SIGNED_GOVERNANCE_TRANSCRIPT",
    "AML_GOVERNANCE_WITNESS_QUORUM",
    "AML_RUNTIME_DISAGREEMENT_REPORT",
    "AML_GOVERNANCE_DISCLOSURE",
    "AML_GOVERNANCE_POLICY_TRANSITION"
  ],
  "claim_boundary": "This is a project-maintained API preservation contract for the declared consumer surface. It is not a promise that unreleased preview behavior will never change, and it is not independent certification or standards status."
}
