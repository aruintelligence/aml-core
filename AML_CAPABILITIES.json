{
  "language": "ĀML — ĀRU Meaning Language",
  "version": "1.3.0",
  "status": "research-prototype",
  "entry_points": {
    "cli": "bin/aml.js",
    "lsp": "bin/aml-lsp.js",
    "javascript": "index.js",
    "browser": "docs/aml-browser.js",
    "playground": "https://aruintelligence.github.io/aml-core/playground.html",
    "vscode": "editors/vscode/package.json"
  },
  "compiler": {
    "lexer": true,
    "parser": true,
    "ast": true,
    "abstract_meaning_tree": true,
    "html_output": true,
    "render_decisions": true,
    "pure_in_memory_compile": true,
    "machine_intent_to_aml": true,
    "accountable_intent_execution": true,
    "semantic_diff": true,
    "semantic_risk_diff": true,
    "policy_diff": true,
    "multi_policy_matrix": true,
    "execution_provenance_graph": true
  },
  "policy": {
    "default_engine": "restorative_v1",
    "decision_json_schema": "schema/render-decision.schema.json",
    "pluggable_policy_engines": true,
    "custom_policy_functions": true,
    "policy_composition": true,
    "policy_profiles": true,
    "policy_consensus": true,
    "weighted_policy_consensus": true,
    "explicit_policy_dissent": true,
    "signed_data_only_policy_packs": true,
    "policy_pack_ed25519_attestation": true,
    "builtin_profiles": ["calm_default", "strict_attention", "privacy_first", "accessibility_first", "human_first"],
    "builtin_policies": [
      "restorative_v1",
      "attention_conservative_v1",
      "consent_guard_v1",
      "privacy_guard_v1",
      "session_attention_budget_v1",
      "reduced_motion_v1",
      "contrast_safety_v1",
      "cognitive_load_guard_v1"
    ],
    "counterfactual_policy_simulation": true,
    "runtime_context": true,
    "runtime_consent": true,
    "runtime_privacy_consent": true,
    "time_scoped_consent_ledger": true,
    "consent_expiration": true,
    "consent_revocation": true,
    "reduced_motion_context": true,
    "high_contrast_context": true,
    "max_cognitive_load_context": true,
    "session_attention_budget": true,
    "cumulative_attention_accounting": true
  },
  "accessibility": {
    "declarative_node_audit": true,
    "tree_audit": true,
    "reduced_motion_check": true,
    "contrast_safety_check": true,
    "keyboard_accessibility_check": true,
    "text_alternative_check": true,
    "cognitive_load_check": true,
    "wcag_replacement": false
  },
  "accountability": {
    "execution_receipts": true,
    "execution_receipt_schema": "schema/execution-receipt.schema.json",
    "runtime_audit_stream": true,
    "sha256_hash_chained_audit_entries": true,
    "signed_audit_checkpoints": true,
    "audit_checkpoint_ed25519_attestation": true,
    "attention_ledger": true,
    "attention_ledger_integrity_verification": true,
    "attention_ledger_summary": true,
    "cumulative_budget_enforcement": true,
    "consent_ledger": true,
    "consent_ledger_hash_chain": true,
    "execution_provenance_graph": true,
    "receipt_merkle_batching": true,
    "receipt_inclusion_proofs": true,
    "intent_hash": true,
    "generated_aml_hash": true,
    "policy_simulation_hash": true,
    "render_decision_hash": true,
    "output_hash": true,
    "receipt_hash": true,
    "ed25519_execution_receipt_attestation": true
  },
  "integrity": {
    "sha256_build_manifest": true,
    "ed25519_build_attestation": true,
    "embedded_public_key_fingerprint": true,
    "manifest_tamper_detection": true,
    "execution_receipt_tamper_detection": true,
    "policy_pack_tamper_detection": true,
    "audit_stream_tamper_detection": true,
    "audit_checkpoint_binding": true,
    "attention_ledger_accounting_tamper_detection": true,
    "consent_ledger_tamper_detection": true,
    "provenance_graph_binding": true,
    "merkle_inclusion_verification": true
  },
  "tooling": {
    "compile": true,
    "generate_from_intent": true,
    "execute_accountable_intent": true,
    "verify_execution_receipt": true,
    "semantic_diff": true,
    "semantic_risk_diff": true,
    "policy_diff": true,
    "policy_matrix": true,
    "policy_consensus": true,
    "sign_policy_pack": true,
    "verify_policy_pack": true,
    "verify_runtime_audit_stream": true,
    "sign_runtime_audit_checkpoint": true,
    "verify_runtime_audit_checkpoint": true,
    "cumulative_attention_accounting": true,
    "verify_attention_ledger": true,
    "consent_ledger": true,
    "resolve_time_scoped_consent": true,
    "build_execution_provenance_graph": true,
    "verify_execution_provenance_graph": true,
    "build_receipt_merkle_tree": true,
    "verify_receipt_inclusion_proof": true,
    "accessibility_audit": true,
    "simulate_policies": true,
    "list_policies": true,
    "list_policy_profiles": true,
    "validate": true,
    "inspect": true,
    "explain": true,
    "lint": true,
    "verify": true,
    "benchmark": true,
    "local_markdown_link_integrity_check": true,
    "browser_playground": true,
    "vscode_language_definition": true,
    "language_intelligence_api": true,
    "stdio_language_server": true,
    "lsp_completion": true,
    "lsp_hover": true,
    "lsp_semantic_diagnostics": true
  },
  "verification": {
    "ci": true,
    "unit_tests": true,
    "example_suite": true,
    "local_documentation_link_test": true,
    "canonical_allow_fixture": "conformance/allow.aml",
    "canonical_suppress_fixture": "conformance/suppress.aml",
    "browser_core_parity": true,
    "reproducible_build_test": true,
    "semantic_diagnostic_tests": true,
    "build_manifest_hash_verification": true,
    "post_build_tamper_detection": true,
    "execution_receipt_tests": true,
    "signed_execution_receipt_tests": true,
    "policy_pack_signature_tests": true,
    "semantic_diff_tests": true,
    "semantic_risk_diff_tests": true,
    "policy_diff_tests": true,
    "policy_matrix_tests": true,
    "policy_consensus_tests": true,
    "runtime_audit_stream_tests": true,
    "signed_audit_checkpoint_tests": true,
    "cumulative_attention_tests": true,
    "attention_ledger_integrity_tests": true,
    "consent_expiration_revocation_tests": true,
    "consent_ledger_tamper_tests": true,
    "receipt_merkle_inclusion_tests": true,
    "provenance_graph_binding_tests": true,
    "accessibility_policy_tests": true,
    "accessibility_audit_tests": true
  },
  "diagnostics": ["AML001", "AML002", "AML003", "AML004", "AML005", "AML_PARSE"],
  "non_claims": [
    "No claim that current scores objectively measure human attention.",
    "No claim that current scores objectively measure restoration or wellbeing.",
    "No claim that the prototype constitutes a universal ethical standard.",
    "Accessibility policies and audits do not replace WCAG conformance or assistive-technology testing.",
    "Cryptographic signatures prove integrity and key possession, not moral correctness or institutional trustworthiness.",
    "Merkle inclusion proofs prove membership in a committed batch, not truthfulness of the underlying receipt content."
  ]
}
