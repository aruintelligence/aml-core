{
  "language": "ĀML — ĀRU Meaning Language",
  "version": "1.1.0",
  "status": "research-prototype-active-development",
  "entry_points": {
    "cli": "bin/aml.js",
    "lsp": "bin/aml-lsp.js",
    "javascript": "index.js",
    "browser": "docs/aml-browser.js",
    "playground": "https://aruintelligence.github.io/aml-core/playground.html",
    "vscode": "editors/vscode/package.json"
  },
  "compiler": {
    "lexer": true,
    "parser": true,
    "ast": true,
    "abstract_meaning_tree": true,
    "html_output": true,
    "render_decisions": true,
    "pure_in_memory_compile": true,
    "reproducible_timestamp_option": true,
    "sha256_build_manifest": true,
    "machine_intent_to_aml": true
  },
  "language_features": {
    "blocks": true,
    "properties": true,
    "string_values": true,
    "numeric_values": true,
    "identifier_values": true,
    "single_binary_comparison_properties": true,
    "comparison_operators": [">", ">=", "<", "<=", "=", "==", "!="]
  },
  "policy": {
    "default_engine": "restorative_v1",
    "pluggable_policy_engines": true,
    "custom_policy_functions": true,
    "builtin_policies": ["restorative_v1", "attention_conservative_v1"],
    "counterfactual_policy_simulation": true,
    "declared_attention_cost": true,
    "declared_restoration_value": true,
    "allow_suppress_decision": true,
    "decision_json_schema": "schema/render-decision.schema.json"
  },
  "integrity": {
    "sha256_build_manifest": true,
    "ed25519_build_attestation": true,
    "embedded_public_key_fingerprint": true,
    "manifest_tamper_detection": true
  },
  "tooling": {
    "compile": true,
    "generate_from_intent": true,
    "validate": true,
    "inspect": true,
    "explain": true,
    "lint": true,
    "verify": true,
    "benchmark": true,
    "browser_playground": true,
    "vscode_language_definition": true,
    "language_intelligence_api": true,
    "stdio_language_server": true,
    "lsp_completion": true,
    "lsp_hover": true,
    "lsp_semantic_diagnostics": true
  },
  "verification": {
    "ci": true,
    "unit_tests": true,
    "example_suite": true,
    "canonical_allow_fixture": "conformance/allow.aml",
    "canonical_suppress_fixture": "conformance/suppress.aml",
    "browser_core_parity": true,
    "reproducible_build_test": true,
    "semantic_diagnostic_tests": true,
    "editor_asset_tests": true,
    "build_manifest_hash_verification": true,
    "post_build_tamper_detection": true,
    "cli_bundle_verification": true,
    "language_service_tests": true,
    "lsp_core_tests": true,
    "policy_engine_tests": true,
    "intent_compiler_tests": true,
    "build_attestation_tests": true,
    "counterfactual_policy_tests": true
  },
  "diagnostics": ["AML001", "AML002", "AML003", "AML004", "AML005", "AML_PARSE"],
  "non_claims": [
    "No claim that current scores objectively measure human attention.",
    "No claim that current scores objectively measure restoration or wellbeing.",
    "No claim that the prototype constitutes a universal ethical standard."
  ]
}
