{
  "name": "aml-core",
  "version": "1.3.0",
  "description": "ĀML — ĀRU Meaning Language: accountable AI execution with signed policies, semantic diffs, runtime audit streams, accessibility policies, and cumulative attention accounting",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "type": "module",
  "bin": {
    "aml": "./bin/aml.js",
    "aml-lsp": "./bin/aml-lsp.js"
  },
  "scripts": {
    "start": "node bin/aml.js help",
    "compile": "node bin/aml.js compile examples/transmission-061.aml",
    "validate": "node bin/aml.js validate examples/transmission-061.aml",
    "inspect": "node bin/aml.js inspect examples/transmission-061.aml",
    "explain": "node bin/aml.js explain examples/simple.aml",
    "lint": "node bin/aml.js lint examples/simple.aml",
    "verify": "node bin/aml.js verify dist/build_manifest.json",
    "check:links": "node scripts/check-local-links.js",
    "benchmark": "node benchmarks/run.js",
    "lsp": "node bin/aml-lsp.js",
    "test": "node --test"
  },
  "keywords": [
    "aml",
    "aru",
    "aru-meaning-language",
    "meaning-language",
    "meaning-native-computing",
    "accountable-ai",
    "accountable-rendering",
    "ai-execution-receipts",
    "signed-policy-pack",
    "semantic-diff",
    "policy-diff",
    "runtime-audit-stream",
    "accessibility-policy",
    "cumulative-attention",
    "attention-budget",
    "privacy-aware-ui",
    "consent-aware-ui",
    "policy-engine",
    "policy-profiles",
    "ethical-render-gate",
    "semantic-ui",
    "ai-generated-ui",
    "language-server",
    "ed25519-attestation"
  ],
