{
  "name": "aml-core",
  "version": "1.1.0",
  "description": "ĀML — ĀRU Meaning Language: a meaning-native, accountable interface compiler and EthicalRenderGate research prototype",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "type": "module",
  "bin": {
    "aml": "./bin/aml.js",
    "aml-lsp": "./bin/aml-lsp.js"
  },
  "scripts": {
    "start": "node bin/aml.js help",
    "compile": "node bin/aml.js compile examples/transmission-061.aml",
    "validate": "node bin/aml.js validate examples/transmission-061.aml",
    "inspect": "node bin/aml.js inspect examples/transmission-061.aml",
    "explain": "node bin/aml.js explain examples/simple.aml",
    "lint": "node bin/aml.js lint examples/simple.aml",
    "verify": "node bin/aml.js verify dist/build_manifest.json",
    "benchmark": "node benchmarks/run.js",
    "lsp": "node bin/aml-lsp.js",
    "test": "node --test"
  },
  "keywords": [
    "aml",
    "aru",
    "aru-meaning-language",
    "meaning-language",
    "meaning-native-computing",
    "meaning-native-interface",
    "accountable-interfaces",
    "accountable-rendering",
    "ethical-rendering",
    "ethical-render-gate",
    "semantic-computing",
    "semantic-ui",
    "policy-aware-ui",
    "ai-generated-ui",
    "attention-aware-interface",
    "language-server",
    "restoration-engine"
  ],
  "author": "ĀRU Intelligence Inc.",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
