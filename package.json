{
  "name": "aml-core",
  "version": "1.3.0",
  "description": "ĀML — accountable AI interface firewall, meaning-native policy execution, View Meaning, semantic diffs, signed receipts, proof-carrying interfaces, and governed cross-system trust",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "type": "module",
  "bin": {
    "aml": "./bin/aml.js",
    "aml-meaning": "./bin/aml-meaning.js",
    "aml-release-proof": "./bin/aml-release-proof.js",
    "aml-release-quorum": "./bin/aml-release-quorum.js",
    "aml-release-profile": "./bin/aml-release-profile.js",
    "aml-github-attestation": "./bin/aml-github-attestation.js",
    "aml-lsp": "./bin/aml-lsp.js",
    "aml-serve": "./bin/aml-serve.js",
    "aml-agent-ui": "./bin/aml-agent-ui.js",
    "aml-agent-ui-serve": "./bin/aml-agent-ui-serve.js",
    "aml-governance-stream": "./bin/aml-governance-stream.js",
    "aml-governance-stream-serve": "./bin/aml-governance-stream-serve.js",
    "aml-governance-transcript": "./bin/aml-governance-transcript.js",
    "aml-governance-transcript-verify": "./bin/aml-governance-transcript-verify.js",
    "aml-governance-transcript-sign": "./bin/aml-governance-transcript-sign.js",
    "aml-governance-transcript-signature-verify": "./bin/aml-governance-transcript-signature-verify.js",
    "aml-brand-verify": "./bin/aml-brand-verify.js"
  },
  "scripts": {
    "start": "node bin/aml.js help",
    "serve": "node bin/aml-serve.js",
    "agent-ui": "node bin/aml-agent-ui.js conformance/agent-ui/mixed.json",
    "agent-ui:serve": "node bin/aml-agent-ui-serve.js",
    "governance-stream": "node bin/aml-governance-stream.js conformance/governance-stream/mixed.ndjson",
    "governance-stream:serve": "node bin/aml-governance-stream-serve.js",
    "governance-transcript": "node bin/aml-governance-transcript.js conformance/governance-stream/mixed.ndjson",
    "compile": "node bin/aml.js compile examples/transmission-061.aml",
    "validate": "node bin/aml.js validate examples/transmission-061.aml",
    "inspect": "node bin/aml.js inspect examples/transmission-061.aml",
    "explain": "node bin/aml.js explain examples/simple.aml",
    "lint": "node bin/aml.js lint examples/simple.aml",
    "verify": "node bin/aml.js verify dist/build_manifest.json",
    "proof": "node demos/undeniable-proof/replay-proof.mjs && node scripts/check-flood-fixtures.js",
    "proof:report": "node scripts/proof-report.mjs",
    "fingerprint": "node bin/aml-meaning.js",
    "meaning-manifest": "node bin/aml-meaning.js manifest",
    "release-proof": "node bin/aml-release-proof.js",
    "release-quorum": "node bin/aml-release-quorum.js",
    "release-profile": "node bin/aml-release-profile.js",
    "check:links": "node scripts/check-local-links.js",
    "meaning-gate": "node scripts/meaning-gate.js",
    "benchmark": "node benchmarks/run.js",
    "lsp": "node bin/aml-lsp.js",
    "test": "node --test"
  },
